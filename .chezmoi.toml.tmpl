{{- $machineRole := promptChoiceOnce . "machineRole" "Machine role" (list "server" "desktop") "server" -}}
{{- $desktopShell := "niri-quickshell" -}}
{{- if eq $machineRole "desktop" -}}
{{-   $desktopShell = promptChoiceOnce . "desktopShell" "Desktop shell" (list "niri-quickshell" "noctalia" "dux-shell") "niri-quickshell" -}}
{{- end -}}

[data]
    machineRole = {{ $machineRole | quote }}
{{- if eq $machineRole "desktop" }}
    desktopShell = {{ $desktopShell | quote }}
{{- end }}
