#!/usr/bin/env bash
# WeChat's bundled UI engine implements zwp_text_input_v3 and only takes that
# native Wayland path (inline preedit, cursor-following candidate window) when
# it sees this Qt-style hint. The session-wide QT_IM_MODULE=fcitx and
# QT_IM_MODULES=wayland;fcitx push it into a degraded fallback instead, which
# shows raw pinyin in-app and renders the first candidate inside the panel.
# Per-app override, per the fcitx5 Wayland guidance of not forcing IM modules
# globally. Ref: AUR tencent-wechat launch script.
unset QT_IM_MODULES
export QT_IM_MODULE="text-input-unstable-v3"
export QT_QPA_PLATFORM="wayland;xcb"
exec /opt/wechat/wechat "$@"
