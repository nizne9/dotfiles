{{- if eq (get . "machineRole") "desktop" -}}
#!/usr/bin/env bash
set -euo pipefail

profile="$HOME/.config/fcitx5/profile"
if [[ -e "$profile" ]]; then
  exit 0
fi

mkdir -p "${profile%/*}"
cat > "$profile" <<'EOF'
[Groups/0]
# Group Name
Name=Default
# Layout
Default Layout=us
# Default Input Method
DefaultIM=rime

[Groups/0/Items/0]
# Name
Name=keyboard-us
# Layout
# Layout=

[Groups/0/Items/1]
# Name
Name=rime
# Layout
# Layout=

[GroupOrder]
0=Default
EOF
{{- end -}}
