#!/usr/bin/env bash
set -euo pipefail

# Re-run when any package list changes.
# common-packages: {{ include "packages/common.txt" | sha256sum }}
{{- if eq (get . "machineRole") "desktop" }}
# desktop-packages: {{ include "packages/desktop.txt" | sha256sum }}
# shell-packages: {{ include (printf "packages/desktop-%s.txt" (get . "desktopShell")) | sha256sum }}
{{- end }}

source_dir={{ .chezmoi.sourceDir | quote }}
packages=()

while IFS= read -r pkg; do
  packages+=("$pkg")
done < <(grep -hE '^[^#[:space:]]' "$source_dir/packages/common.txt")

{{- if eq (get . "machineRole") "desktop" }}
while IFS= read -r pkg; do
  packages+=("$pkg")
done < <(grep -hE '^[^#[:space:]]' "$source_dir/packages/desktop.txt")
while IFS= read -r pkg; do
  packages+=("$pkg")
done < <(grep -hE '^[^#[:space:]]' "$source_dir/packages/{{ printf "desktop-%s.txt" (get . "desktopShell") }}")
{{- end }}

# Fast path when everything is installed, so apply does not prompt for
# sudo on every run.
missing=()
for pkg in "${packages[@]}"; do
  pacman -Qq "$pkg" >/dev/null 2>&1 || missing+=("$pkg")
done
(( ${#missing[@]} )) || exit 0

if ! command -v paru >/dev/null 2>&1; then
  printf 'Install paru to add these packages: %s\n' "${missing[*]}" >&2
  exit 1
fi

# A single paru transaction resolves official repos and the AUR together
# and reports all unknown targets at once.
paru -S --needed --noconfirm "${missing[@]}"
