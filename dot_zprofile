# .zprofile - sourced by login shells only
# Environment setup: PATH, MANPATH

# PATH
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

# LaTeX (only if installed)
if [[ -d "$HOME/texlive/2026/bin/x86_64-linux" ]]; then
  export PATH="$HOME/texlive/2026/bin/x86_64-linux:$PATH"
  export MANPATH="$HOME/texlive/2026/texmf-dist/doc/man${MANPATH:+:$MANPATH}"
  export INFOPATH="$HOME/texlive/2026/texmf-dist/doc/info${INFOPATH:+:$INFOPATH}"
fi
