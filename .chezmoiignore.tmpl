# Desktop/Wayland settings are selected by the local chezmoi data key
# `desktopProfile`, not by hostname. Valid values are:
#   none
#   niri-quickshell
{{- $desktopProfile := get . "desktopProfile" | default "none" -}}
{{- if ne $desktopProfile "niri-quickshell" }}
.config/niri/
.config/foot/
.config/kanshi/
.config/quickshell/
.config/environment.d/
.config/systemd/user/kanshi.service
{{ end }}
