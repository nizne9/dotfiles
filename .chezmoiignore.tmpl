# Repo-internal package lists, not deployed.
packages/

# Desktop/Wayland configs are only deployed on machines whose
# machineRole is "desktop". Valid values:
#   desktop
#   server
{{- $machineRole := get . "machineRole" -}}
{{- if not (has $machineRole (list "desktop" "server")) -}}
{{-   fail (printf "machineRole must be \"desktop\" or \"server\" in %s (run \"chezmoi init\" to set it), got %q" .chezmoi.configFile $machineRole) -}}
{{- end -}}
{{- if ne $machineRole "desktop" }}
.config/niri/
.config/foot/
.config/kanshi/
.config/quickshell/
.config/environment.d/
.config/systemd/user/kanshi.service
.config/systemd/user/udiskie.service
.config/systemd/user/swayidle.service
.config/swaylock/
.config/fcitx5/
.config/fontconfig/
.config/brave-flags.conf
.local/share/fcitx5/
{{- else }}
# Desktop machines also pick a shell variant via desktopShell. Valid values:
#   niri-quickshell  (the custom shell in .config/quickshell/niri-quickshell)
#   dux-shell        (Dux Shell, formerly DankMaterialShell)
{{-   $desktopShell := get . "desktopShell" -}}
{{-   if not (has $desktopShell (list "niri-quickshell" "noctalia" "dux-shell")) -}}
{{-     fail (printf "desktopShell must be \"niri-quickshell\" or \"dux-shell\" on a desktop machine (set it in %s), got %q" .chezmoi.configFile $desktopShell) -}}
{{-   end -}}
{{-   if ne $desktopShell "niri-quickshell" }}
.config/quickshell/
.config/swaylock/
.config/niri/shell-niri-quickshell.kdl
.config/systemd/user/swayidle.service
{{-   end }}
{{-   if ne $desktopShell "dux-shell" }}
.config/niri/shell-dux-shell.kdl
{{-   end }}
{{-   if ne $desktopShell "noctalia" }}
.config/niri/shell-noctalia.kdl
{{-   end }}
{{- end }}
